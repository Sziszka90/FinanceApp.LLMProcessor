# Non-secret production configuration. Secrets are loaded from Azure Key Vault.
KEY_VAULT_URI=https://finance-app-key-vault.vault.azure.net/

AZURE_OPENAI_ENDPOINT=https://finance-app-open-ai.services.ai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=FinanceAppLunaModel
AZURE_OPENAI_API_VERSION=2024-10-21

RABBITMQ_HOST=finance-app-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
